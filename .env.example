# Kopyala: cp .env.example .env — gerçek değerleri ASLA commit'leme.
# Rastgele değer üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Oturum imza anahtarı (en az 32 karakter). Değiştirilirse tüm oturumlar kapanır.
JWT_SECRET=

# /superadmin kurtarma anahtarı (en az 32 karakter)
RECOVERY_SECRET=

# Veritabanı ilk oluşturulurken admin şifresi (en az 12 karakter). Boşsa rastgele üretilip bir kez konsola yazılır.
ADMIN_INITIAL_PASSWORD=

PORT=3001
NODE_ENV=production
CORS_ORIGIN=https://akdenizgkt.com
